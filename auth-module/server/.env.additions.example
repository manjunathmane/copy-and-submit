# Add these to your existing server/.env (do not replace your database settings)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email-service-username
SMTP_PASSWORD=your-email-service-password
MAIL_FROM=Currency Tracker <no-reply@example.com>
